{
  "name": "chillscope",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "yarn --cwd chart install --frozen-lockfile && yarn --cwd chart build",
    "start": "yarn build:chart && ng serve",
    "predev": "yarn build:chart",
    "dev": "yarn watch:chart & ng serve",
    "build": "yarn build:chart && ng build",
    "build:chart": "yarn --cwd chart build",
    "watch:chart": "yarn --cwd chart watch",
    "pretest": "yarn build:chart",
    "test": "yarn --cwd chart test && ng test",
    "test:chart": "yarn --cwd chart test",
    "verify": "yarn lint && yarn test && yarn build",
    "docker:build": "docker build --tag chillscope:local .",
    "docker:run": "docker run --rm --name chillscope --read-only --tmpfs /tmp:rw,noexec,nosuid,size=16m --cap-drop ALL --security-opt no-new-privileges --publish 127.0.0.1:8080:8080 chillscope:local",
    "docker:smoke": "sh scripts/smoke-docker.sh",
    "docker:verify": "yarn docker:build && yarn docker:smoke",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"chart/src/**/*.{ts,vue,css}\" \"*.{json,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.18.x",
    "yarn": "1.22.22"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@chillscope/chart": "link:./chart",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@jsverse/transloco": "^8.4.0",
    "@primeuix/themes": "^2.0.3",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^21",
    "eslint": "^9",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8",
    "vitest": "^4.0.8"
  }
}
